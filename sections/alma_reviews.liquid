{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="alma-reviews section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}
    
    <div class="alma-reviews-container" data-auto-rotate="{{ section.settings.auto_rotate }}" data-rotation-speed="{{ section.settings.rotation_speed }}">
      <div class="alma-reviews-track">
        {%- for block in section.blocks -%}
          <div class="alma-review-card{% if forloop.first %} active{% endif %}" 
               data-index="{{ forloop.index0 }}" 
               {{ block.shopify_attributes }}>
            <div class="alma-review-stars">
              {%- for i in (1..5) -%}
                <span class="star">⭐</span>
              {%- endfor -%}
            </div>
            
            <div class="alma-review-content">
              {{ block.settings.text }}
            </div>
            
            <div class="alma-review-author">
              <strong>{{ block.settings.name }}</strong>
              {%- if block.settings.location != blank -%}
                <span class="alma-review-location">{{ block.settings.location }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      
      {%- if section.blocks.size > 1 -%}
        <div class="alma-reviews-navigation">
          <div class="alma-review-dots">
            {%- for block in section.blocks -%}
              <button class="alma-review-dot{% if forloop.first %} active{% endif %}" 
                      data-index="{{ forloop.index0 }}" 
                      aria-label="Go to review {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
.alma-reviews {
  overflow: hidden;
}

.alma-reviews-container {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  overflow: hidden;
}

.alma-reviews-track {
  display: flex;
  align-items: stretch;
  gap: 2rem;
  padding: 2rem 0;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  justify-content: center;
}

.alma-review-card {
  flex: 0 0 280px;
  background: transparent;
  border-radius: 0;
  padding: 1.5rem;
  box-shadow: none;
  border: none;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0.5;
  transform: scale(0.8);
  position: relative;
  height: auto;
  min-height: 300px;
}

.alma-review-card.active {
  flex: 0 0 450px !important;
  opacity: 1 !important;
  transform: scale(1.1) !important;
  border: none !important;
  box-shadow: none !important;
  z-index: 10 !important;
  padding: 2.5rem !important;
  min-height: 350px !important;
}

.alma-review-stars {
  text-align: center;
  font-size: 1.5rem;
  margin-bottom: 1.5rem;
  line-height: 1;
}

.alma-review-content {
  font-family: 'Lora', serif;
  font-size: 1rem;
  line-height: 1.6;
  color: var(--alma-primary-green);
  margin-bottom: 1.5rem;
  text-align: center;
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: font-size 0.6s ease;
}

.alma-review-card.active .alma-review-content {
  font-size: 1.3rem !important;
  line-height: 1.7 !important;
}

.alma-review-card.active .alma-review-stars {
  font-size: 2rem !important;
}

.alma-review-card.active .alma-review-author strong {
  font-size: 1.3rem !important;
}

.alma-review-content p {
  margin: 0;
  font-style: italic;
}

.alma-review-author {
  text-align: center;
  padding-top: 1rem;
}

.alma-review-author strong {
  display: block;
  color: var(--alma-dark-green);
  font-size: 1.1rem;
  margin-bottom: 0.25rem;
}

.alma-review-location {
  color: var(--alma-primary-green);
  font-size: 0.9rem;
  opacity: 0.8;
}

.alma-reviews-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rem;
}

.alma-review-dots {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  margin-bottom: 0.5rem;
}

.alma-review-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--alma-primary-green, #7E9278);
  border: none;
  cursor: pointer;
  opacity: 0.3;
  transition: all 0.3s ease;
  padding: 0;
}

.alma-review-dot.active {
  opacity: 1;
  transform: scale(1.3);
}

.alma-review-dot:hover {
  opacity: 0.7;
}

/* Mobile Styles */
@media screen and (max-width: 749px) {
  .alma-reviews-track {
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
  }
  
  .alma-review-card {
    flex: none !important;
    width: 100% !important;
    max-width: 350px !important;
    transform: none !important;
    opacity: 1 !important;
    padding: 2rem !important;
    min-height: auto !important;
  }
  
  .alma-review-card:not(.active) {
    display: none;
  }
  
  .alma-review-card.active {
    border: none !important;
    box-shadow: none !important;
  }
  
  .alma-review-content {
    font-size: 1rem !important;
    min-height: auto !important;
  }
  
  .alma-review-stars {
    font-size: 1.5rem !important;
  }
  
  .alma-review-author strong {
    font-size: 1.1rem !important;
  }
  
  .alma-reviews-navigation {
    margin-top: 1.5rem;
  }
}

/* Animation for auto-rotation */
@keyframes pulse-active {
  0%, 100% { transform: scale(1.1); }
  50% { transform: scale(1.12); }
}

@media screen and (min-width: 750px) {
  .alma-review-card.active {
    animation: pulse-active 4s ease-in-out infinite;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const containers = document.querySelectorAll('.alma-reviews-container');
  
  containers.forEach(container => {
    const track = container.querySelector('.alma-reviews-track');
    const cards = Array.from(container.querySelectorAll('.alma-review-card'));
    const dots = Array.from(container.querySelectorAll('.alma-review-dot'));
    
    if (cards.length === 0) return;
    
    let currentIndex = 0;
    let autoRotateInterval;
    let isDesktop = window.innerWidth >= 750;
    
    const autoRotate = container.dataset.autoRotate === 'true';
    const rotationSpeed = parseInt(container.dataset.rotationSpeed) || 4000;
    
    function updateDisplay() {
      isDesktop = window.innerWidth >= 750;
      
      // Remove active class from all cards and dots
      cards.forEach(card => card.classList.remove('active'));
      dots.forEach(dot => dot.classList.remove('active'));
      
      // Set active state for current card and dot
      if (cards[currentIndex]) {
        cards[currentIndex].classList.add('active');
      }
      if (dots[currentIndex]) {
        dots[currentIndex].classList.add('active');
      }
      
      // Desktop: Position the track to center the active card
      if (isDesktop) {
        const baseCardWidth = 280;
        const activeCardWidth = 450;
        const gap = 32;
        const avgCardWidth = baseCardWidth + gap;
        const containerWidth = container.offsetWidth;
        
        // Calculate offset to center the active card
        let offset = -(currentIndex * avgCardWidth) + (containerWidth / 2);
        
        // Adjust offset based on active card width difference
        const widthDiff = (activeCardWidth - baseCardWidth) / 2;
        offset -= widthDiff;
        
        track.style.transform = `translateX(${offset}px)`;
      } else {
        // Mobile: Reset transform as we use display:none
        track.style.transform = 'none';
      }
    }
    
    function goToReview(index) {
      if (index < 0 || index >= cards.length) return;
      currentIndex = index;
      updateDisplay();
      stopAutoRotate();
    }
    
    function nextReview() {
      currentIndex = (currentIndex + 1) % cards.length;
      updateDisplay();
    }
    
    function prevReview() {
      currentIndex = (currentIndex - 1 + cards.length) % cards.length;
      updateDisplay();
    }
    
    function startAutoRotate() {
      if (autoRotate && cards.length > 1) {
        stopAutoRotate();
        autoRotateInterval = setInterval(nextReview, rotationSpeed);
      }
    }
    
    function stopAutoRotate() {
      if (autoRotateInterval) {
        clearInterval(autoRotateInterval);
        autoRotateInterval = null;
      }
    }
    
    // Event listeners for dots navigation
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToReview(index);
      });
    });
    
    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    });
    
    track.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    });
    
    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          // Swipe left - next
          nextReview();
        } else {
          // Swipe right - prev
          prevReview();
        }
        stopAutoRotate();
      }
    }
    
    // Keyboard navigation
    container.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        prevReview();
        stopAutoRotate();
      } else if (e.key === 'ArrowRight') {
        nextReview();
        stopAutoRotate();
      }
    });
    
    // Handle window resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(updateDisplay, 100);
    });
    
    // Initialize
    updateDisplay();
    startAutoRotate();
    
    // Pause auto-rotate when user hovers over the container (desktop only)
    container.addEventListener('mouseenter', () => {
      if (isDesktop) {
        stopAutoRotate();
      }
    });
    
    container.addEventListener('mouseleave', () => {
      if (isDesktop) {
        startAutoRotate();
      }
    });
  });
});
</script>

