{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="alma-reviews section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}
    
    <div class="alma-reviews-container" data-auto-rotate="{{ section.settings.auto_rotate }}" data-rotation-speed="{{ section.settings.rotation_speed }}">
      <div class="alma-reviews-track">
        {%- for block in section.blocks -%}
          <div class="alma-review-card" 
               data-index="{{ forloop.index0 }}" 
               {{ block.shopify_attributes }}>
            <div class="alma-review-stars">
              {%- for i in (1..5) -%}
                <span class="star">⭐</span>
              {%- endfor -%}
            </div>
            
            <div class="alma-review-content">
              {{ block.settings.text }}
            </div>
            
            <div class="alma-review-author">
              <strong>{{ block.settings.name }}</strong>
              {%- if block.settings.location != blank -%}
                <span class="alma-review-location">{{ block.settings.location }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      
      {%- if section.settings.show_navigation -%}
        <div class="alma-reviews-navigation">
          <button class="alma-review-nav alma-review-prev" aria-label="Previous review">‹</button>
          <div class="alma-review-dots">
            {%- for block in section.blocks -%}
              <button class="alma-review-dot" 
                      data-index="{{ forloop.index0 }}" 
                      aria-label="Go to review {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
          <button class="alma-review-nav alma-review-next" aria-label="Next review">›</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
.alma-reviews {
  overflow: hidden;
}

.alma-reviews-container {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  overflow: hidden;
}

.alma-reviews-track {
  display: flex;
  align-items: stretch;
  gap: 2rem;
  padding: 2rem 0;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  justify-content: center;
}

.alma-review-card {
  flex: 0 0 300px;
  background: white;
  border-radius: 16px;
  padding: 2rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  border: 2px solid transparent;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0.7;
  transform: scale(0.9);
  position: relative;
}

.alma-review-card.active {
  flex: 0 0 400px;
  opacity: 1;
  transform: scale(1);
  border-color: var(--alma-primary-green);
  box-shadow: 0 8px 40px rgba(126, 146, 120, 0.2);
  z-index: 2;
}

.alma-review-stars {
  text-align: center;
  font-size: 1.5rem;
  margin-bottom: 1.5rem;
  line-height: 1;
}

.alma-review-content {
  font-family: 'Lora', serif;
  font-size: 1.1rem;
  line-height: 1.6;
  color: var(--alma-primary-green);
  margin-bottom: 1.5rem;
  text-align: center;
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.alma-review-content p {
  margin: 0;
  font-style: italic;
}

.alma-review-author {
  text-align: center;
  border-top: 2px solid var(--alma-green-tint);
  padding-top: 1rem;
}

.alma-review-author strong {
  display: block;
  color: var(--alma-dark-green);
  font-size: 1.1rem;
  margin-bottom: 0.25rem;
}

.alma-review-location {
  color: var(--alma-primary-green);
  font-size: 0.9rem;
  opacity: 0.8;
}

.alma-reviews-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  margin-top: 2rem;
}

.alma-review-nav {
  background: var(--alma-primary-green);
  color: white;
  border: none;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  font-size: 1.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.alma-review-nav:hover {
  background: var(--alma-dark-green);
  transform: scale(1.1);
}

.alma-review-dots {
  display: flex;
  gap: 0.5rem;
}

.alma-review-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--alma-primary-green);
  background: transparent;
  cursor: pointer;
  transition: all 0.3s ease;
}

.alma-review-dot.active {
  background: var(--alma-primary-green);
}

/* Mobile Styles */
@media screen and (max-width: 749px) {
  .alma-reviews-track {
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  
  .alma-review-card,
  .alma-review-card.active {
    flex: none;
    width: 100%;
    max-width: 350px;
    transform: none;
    opacity: 1;
  }
  
  .alma-review-card:not(.active) {
    display: none;
  }
  
  .alma-review-content {
    font-size: 1rem;
    min-height: auto;
  }
}

/* Animation for auto-rotation */
@keyframes pulse-active {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.alma-review-card.active {
  animation: pulse-active 4s ease-in-out infinite;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const containers = document.querySelectorAll('.alma-reviews-container');
  
  containers.forEach(container => {
    const track = container.querySelector('.alma-reviews-track');
    const cards = container.querySelectorAll('.alma-review-card');
    const dots = container.querySelectorAll('.alma-review-dot');
    const prevBtn = container.querySelector('.alma-review-prev');
    const nextBtn = container.querySelector('.alma-review-next');
    
    if (cards.length === 0) return;
    
    let currentIndex = 0; // Start with first card active
    let autoRotateInterval;
    
    const autoRotate = container.dataset.autoRotate === 'true';
    const rotationSpeed = parseInt(container.dataset.rotationSpeed) || 4000;
    
    // Create a circular array by cloning cards
    function setupCircularDisplay() {
      // Clear existing cards
      track.innerHTML = '';
      
      // Create circular array with clones for smooth infinite scroll
      const totalCards = cards.length;
      const cardsToShow = Math.min(3, totalCards); // Show max 3 cards
      
      // Clone all cards multiple times for infinite effect
      for (let i = 0; i < totalCards * 3; i++) {
        const originalIndex = i % totalCards;
        const cardClone = cards[originalIndex].cloneNode(true);
        cardClone.setAttribute('data-original-index', originalIndex);
        track.appendChild(cardClone);
      }
      
      // Start with middle set active
      currentIndex = totalCards;
      updateDisplay();
    }
    
    function updateDisplay() {
      const allCards = track.querySelectorAll('.alma-review-card');
      const totalCards = cards.length;
      
      // Remove active class from all cards and dots
      allCards.forEach(card => card.classList.remove('active'));
      dots.forEach(dot => dot.classList.remove('active'));
      
      // Calculate which cards to show (previous, current, next)
      const centerIndex = currentIndex;
      const leftIndex = centerIndex - 1;
      const rightIndex = centerIndex + 1;
      
      // Set active states
      if (allCards[centerIndex]) {
        allCards[centerIndex].classList.add('active');
      }
      
      // Update dot indicator
      const originalIndex = currentIndex % totalCards;
      if (dots[originalIndex]) {
        dots[originalIndex].classList.add('active');
      }
      
      // Position the track to center the active card
      const cardWidth = 320; // 300px + 20px gap
      const offset = -(centerIndex * cardWidth) + (container.offsetWidth / 2) - (cardWidth / 2);
      track.style.transform = `translateX(${offset}px)`;
    }
    
    function nextReview() {
      const totalCards = cards.length;
      currentIndex++;
      
      // If we've gone too far, reset to beginning of middle set
      if (currentIndex >= totalCards * 2) {
        currentIndex = totalCards;
        track.style.transition = 'none';
        updateDisplay();
        setTimeout(() => {
          track.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
          currentIndex++;
          updateDisplay();
        }, 50);
      } else {
        updateDisplay();
      }
    }
    
    function prevReview() {
      const totalCards = cards.length;
      currentIndex--;
      
      // If we've gone too far back, reset to end of middle set
      if (currentIndex < totalCards) {
        currentIndex = totalCards * 2 - 1;
        track.style.transition = 'none';
        updateDisplay();
        setTimeout(() => {
          track.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
          currentIndex--;
          updateDisplay();
        }, 50);
      } else {
        updateDisplay();
      }
    }
    
    function goToReview(index) {
      const totalCards = cards.length;
      currentIndex = totalCards + index; // Go to middle set + index
      updateDisplay();
    }
    
    function startAutoRotate() {
      if (autoRotate && cards.length > 1) {
        autoRotateInterval = setInterval(nextReview, rotationSpeed);
      }
    }
    
    function stopAutoRotate() {
      if (autoRotateInterval) {
        clearInterval(autoRotateInterval);
        autoRotateInterval = null;
      }
    }
    
    // Navigation event listeners
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        stopAutoRotate();
        nextReview();
        setTimeout(startAutoRotate, 2000);
      });
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        stopAutoRotate();
        prevReview();
        setTimeout(startAutoRotate, 2000);
      });
    }
    
    // Dot navigation
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopAutoRotate();
        goToReview(index);
        setTimeout(startAutoRotate, 2000);
      });
    });
    
    // Pause on hover
    container.addEventListener('mouseenter', stopAutoRotate);
    container.addEventListener('mouseleave', startAutoRotate);
    
    // Initialize
    setupCircularDisplay();
    startAutoRotate();
    
    // Handle window resize
    window.addEventListener('resize', updateDisplay);
  });
});
</script>

