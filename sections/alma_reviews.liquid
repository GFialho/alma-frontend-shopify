{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="alma-reviews section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}
    
    <div class="alma-reviews-container" data-auto-rotate="{{ section.settings.auto_rotate }}" data-rotation-speed="{{ section.settings.rotation_speed }}">
      <div class="alma-reviews-track">
        {%- for block in section.blocks -%}
          <div class="alma-review-card" 
               data-index="{{ forloop.index0 }}" 
               {{ block.shopify_attributes }}>
            <div class="alma-review-stars">
              {%- for i in (1..5) -%}
                <span class="star">⭐</span>
              {%- endfor -%}
            </div>
            
            <div class="alma-review-content">
              {{ block.settings.text }}
            </div>
            
            <div class="alma-review-author">
              <strong>{{ block.settings.name }}</strong>
              {%- if block.settings.location != blank -%}
                <span class="alma-review-location">{{ block.settings.location }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      
    </div>
  </div>
</div>

<style>
.alma-reviews {
  overflow: hidden;
}

.alma-reviews-container {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  overflow: hidden;
}

.alma-reviews-track {
  display: flex;
  align-items: stretch;
  gap: 2rem;
  padding: 2rem 0;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  justify-content: center;
}

.alma-review-card {
  flex: 0 0 280px;
  background: white;
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  border: 2px solid transparent;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0.5;
  transform: scale(0.8);
  position: relative;
}

.alma-review-card.active {
  flex: 0 0 450px;
  opacity: 1;
  transform: scale(1);
  border-color: var(--alma-primary-green);
  box-shadow: 0 12px 50px rgba(126, 146, 120, 0.3);
  z-index: 2;
  padding: 2.5rem;
}

.alma-review-stars {
  text-align: center;
  font-size: 1.5rem;
  margin-bottom: 1.5rem;
  line-height: 1;
}

.alma-review-content {
  font-family: 'Lora', serif;
  font-size: 1.1rem;
  line-height: 1.6;
  color: var(--alma-primary-green);
  margin-bottom: 1.5rem;
  text-align: center;
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.alma-review-content p {
  margin: 0;
  font-style: italic;
}

.alma-review-author {
  text-align: center;
  border-top: 2px solid var(--alma-green-tint);
  padding-top: 1rem;
}

.alma-review-author strong {
  display: block;
  color: var(--alma-dark-green);
  font-size: 1.1rem;
  margin-bottom: 0.25rem;
}

.alma-review-location {
  color: var(--alma-primary-green);
  font-size: 0.9rem;
  opacity: 0.8;
}


/* Mobile Styles */
@media screen and (max-width: 749px) {
  .alma-reviews-track {
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  
  .alma-review-card,
  .alma-review-card.active {
    flex: none;
    width: 100%;
    max-width: 350px;
    transform: none;
    opacity: 1;
  }
  
  .alma-review-card:not(.active) {
    display: none;
  }
  
  .alma-review-content {
    font-size: 1rem;
    min-height: auto;
  }
}

/* Animation for auto-rotation */
@keyframes pulse-active {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.alma-review-card.active {
  animation: pulse-active 4s ease-in-out infinite;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const containers = document.querySelectorAll('.alma-reviews-container');
  
  containers.forEach(container => {
    const track = container.querySelector('.alma-reviews-track');
    const cards = container.querySelectorAll('.alma-review-card');
    
    if (cards.length === 0) return;
    
    let currentIndex = 0;
    let autoRotateInterval;
    
    const autoRotate = container.dataset.autoRotate === 'true';
    const rotationSpeed = parseInt(container.dataset.rotationSpeed) || 4000;
    
    // Create infinite circular array by cloning cards
    function setupInfiniteScroll() {
      // Clear existing cards
      track.innerHTML = '';
      
      // Create multiple sets of cards for seamless infinite scroll
      const totalCards = cards.length;
      const setsToCreate = 5; // Create 5 sets for smooth infinite scrolling
      
      // Clone all cards multiple times
      for (let set = 0; set < setsToCreate; set++) {
        for (let i = 0; i < totalCards; i++) {
          const cardClone = cards[i].cloneNode(true);
          cardClone.setAttribute('data-original-index', i);
          cardClone.setAttribute('data-set', set);
          track.appendChild(cardClone);
        }
      }
      
      // Start with middle set active (set 2, first card)
      currentIndex = totalCards * 2;
      updateDisplay();
    }
    
    function updateDisplay() {
      const allCards = track.querySelectorAll('.alma-review-card');
      const totalCards = cards.length;
      
      // Remove active class from all cards
      allCards.forEach(card => card.classList.remove('active'));
      
      // Set active state for current card
      if (allCards[currentIndex]) {
        allCards[currentIndex].classList.add('active');
      }
      
      // Position the track to center the active card
      const cardWidth = 320; // 280px + 40px gap
      const containerWidth = container.offsetWidth;
      const offset = -(currentIndex * cardWidth) + (containerWidth / 2) - (cardWidth / 2);
      track.style.transform = `translateX(${offset}px)`;
    }
    
    function nextReview() {
      const totalCards = cards.length;
      const totalClonedCards = track.querySelectorAll('.alma-review-card').length;
      
      currentIndex++;
      
      // If we've gone past the third set, reset to the second set seamlessly
      if (currentIndex >= totalCards * 3) {
        // Move to equivalent position in second set
        track.style.transition = 'none';
        currentIndex = totalCards; // Reset to beginning of second set
        updateDisplay();
        
        // Re-enable transition and move to next card
        setTimeout(() => {
          track.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
          currentIndex++;
          updateDisplay();
        }, 50);
      } else {
        updateDisplay();
      }
    }
    
    function startAutoRotate() {
      if (autoRotate && cards.length > 1) {
        autoRotateInterval = setInterval(nextReview, rotationSpeed);
      }
    }
    
    function stopAutoRotate() {
      if (autoRotateInterval) {
        clearInterval(autoRotateInterval);
        autoRotateInterval = null;
      }
    }
    
    // Initialize infinite scroll
    setupInfiniteScroll();
    startAutoRotate();
    
    // Handle window resize
    window.addEventListener('resize', updateDisplay);
  });
});
</script>

{% schema %}
{
  "name": "Alma - Reviews",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "O que nossos clientes dizem",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "default": true,
      "label": "Auto-rotate reviews"
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 2000,
      "max": 8000,
      "step": 1000,
      "unit": "ms",
      "default": 4000,
      "label": "Rotation speed"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
