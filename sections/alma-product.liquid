{% comment %}
  Alma Custom Product Section
  Renders product information with custom design including subscription options
{% endcomment %}

<product-info
  id="AlmaProduct-{{ section.id }}"
  class="alma-product-section section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  {{ 'section-alma-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  
  <div class="page-width">
    <div class="alma-product-grid grid grid--1-col grid--2-col-tablet">
      <!-- Product Media Gallery -->
      <div class="grid__item alma-product__media-wrapper">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>

      <!-- Product Info -->
      <div class="grid__item alma-product__info-wrapper">
        <section
          id="ProductInfo-{{ section.id }}"
          class="alma-product__info-container{% if section.settings.enable_sticky_info %} alma-product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              
              {%- when 'title' -%}
                <div class="alma-product__title" {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                </div>

              {%- when 'subtitle' -%}
                <div class="alma-product__subtitle" {{ block.shopify_attributes }}>
                  <p class="subtitle">{{ block.settings.text }}</p>
                </div>

              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <div class="alma-product__rating" {{ block.shopify_attributes }}>
                    <div class="rating-wrapper">
                      {% liquid
                        assign rating_decimal = 0
                        assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                        if decimal >= 0.3 and decimal <= 0.7
                          assign rating_decimal = 0.5
                        elsif decimal > 0.7
                          assign rating_decimal = 1
                        endif
                      %}
                      <div
                        class="rating"
                        role="img"
                        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                      >
                        <span
                          aria-hidden="true"
                          class="rating-star"
                          style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                        ></span>
                      </div>
                      <p class="rating-text">
                        <span aria-hidden="true">
                          {{- product.metafields.reviews.rating.value }}/{{ product.metafields.reviews.rating.value.scale_max -}}
                        </span>
                      </p>
                      <p class="rating-count">
                        <span aria-hidden="true">({{ product.metafields.reviews.rating_count }} avaliações)</span>
                      </p>
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'price' -%}
                <div id="price-{{ section.id }}" class="alma-product__price" role="status" {{ block.shopify_attributes }}>
                  <div class="price-wrapper">
                    <div class="price price--large">
                      <div class="price__container">
                        <div class="price__regular">
                          <span class="price-item price-item--regular">
                            {{ product.selected_or_first_available_variant.price | money }}
                          </span>
                        </div>
                        {% if product.selected_or_first_available_variant.available == false %}
                          <span class="badge price__badge-sold-out color-inverse">
                            {{ 'products.product.sold_out' | t }}
                          </span>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>

              {%- when 'subscription_selector' -%}
                <div class="alma-subscription-selector" {{ block.shopify_attributes }}>
                  <div class="subscription-options">
                    <div class="subscription-option active" data-type="onetime" onclick="almaToggleSubscription('onetime', '{{ section.id }}')">
                      <div class="subscription-option-title">Compra Única</div>
                      <div class="subscription-option-price">{{ product.selected_or_first_available_variant.price | money }}</div>
                    </div>
                    <div class="subscription-option" data-type="subscription" onclick="almaToggleSubscription('subscription', '{{ section.id }}')">
                      <div class="subscription-option-title">Assinatura</div>
                      <div class="subscription-option-price">{{ product.selected_or_first_available_variant.price | times: 0.8 | money }}/mês</div>
                      <div class="subscription-option-badge">Economize 20%</div>
                    </div>
                  </div>
                  
                  <div class="subscription-message" id="subscription-message-{{ section.id }}">
                    <p class="subscription-message-text">✓ Você receberá 1 frasco todo mês automaticamente com 20% de desconto</p>
                  </div>

                  <input type="hidden" id="subscription-type-{{ section.id }}" name="properties[_subscription_type]" value="onetime">
                  <input type="hidden" id="original-price-{{ section.id }}" value="{{ product.selected_or_first_available_variant.price }}">
                  <input type="hidden" id="subscription-price-{{ section.id }}" value="{{ product.selected_or_first_available_variant.price | times: 0.8 }}">
                </div>

              {%- when 'variant_picker' -%}
                {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}

              {%- when 'quantity_selector' -%}
                <div
                  id="Quantity-Form-{{ section.id }}"
                  class="alma-product-form__quantity"
                  {{ block.shopify_attributes }}
                >
                  {% comment %} TODO: enable theme-check once `item_count_for_variant` is accepted as valid filter {% endcomment %}
                  {% # theme-check-disable %}
                  {%- assign cart_qty = cart
                    | item_count_for_variant: product.selected_or_first_available_variant.id
                  -%}
                  {% # theme-check-enable %}
                  
                  <label class="quantity__label form__label" for="Quantity-{{ section.id }}">
                    Quantidade
                  </label>
                  
                  <div class="quantity-selector-wrapper">
                    <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                      <button class="quantity__button" name="minus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                        </span>
                        {{- 'icon-minus.svg' | inline_asset_content -}}
                      </button>
                      <input
                        class="quantity__input"
                        type="number"
                        name="quantity"
                        id="Quantity-{{ section.id }}"
                        data-cart-quantity="{{ cart_qty }}"
                        data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                          data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                        value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        form="{{ product_form_id }}"
                      >
                      <button class="quantity__button" name="plus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                        </span>
                        {{- 'icon-plus.svg' | inline_asset_content -}}
                      </button>
                    </quantity-input>
                  </div>
                </div>

              {%- when 'buy_buttons' -%}
                <div class="alma-product__buy-buttons" {{ block.shopify_attributes }}>
                  {%- if product != blank -%}
                    <product-form class="product-form" data-section-id="{{ section.id }}">
                      <div class="product-form__error-message-wrapper" role="alert" hidden>
                        <span class="svg-wrapper">
                          {{- 'icon-error.svg' | inline_asset_content -}}
                        </span>
                        <span class="product-form__error-message"></span>
                      </div>

                      {%- form 'product',
                        product,
                        id: product_form_id,
                        class: 'form',
                        novalidate: 'novalidate',
                        data-type: 'add-to-cart-form'
                      -%}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                          {% if product.selected_or_first_available_variant.available == false %}
                            disabled
                          {% endif %}
                          class="product-variant-id"
                        >

                        <div class="product-form__buttons">
                          <button
                            id="ProductSubmitButton-{{ section.id }}"
                            type="submit"
                            name="add"
                            class="alma-add-to-cart-button button button--full-width button--primary"
                            {% if product.selected_or_first_available_variant.available == false %}
                              disabled
                            {% endif %}
                          >
                            <span>
                              {%- if product.selected_or_first_available_variant.available == false -%}
                                {{ 'products.product.sold_out' | t | upcase }}
                              {%- else -%}
                                {{ 'products.product.add_to_cart' | t | upcase }}
                              {%- endif -%}
                            </span>
                            {%- render 'loading-spinner' -%}
                          </button>
                        </div>
                      {%- endform -%}
                    </product-form>
                  {%- endif -%}
                </div>

              {%- when 'trust_badges' -%}
                <div class="alma-product__trust-badges" {{ block.shopify_attributes }}>
                  <div class="trust-badges-grid">
                    {% if block.settings.badge_1 != blank %}
                      <span class="trust-badge">{{ block.settings.badge_1 }}</span>
                    {% endif %}
                    {% if block.settings.badge_2 != blank %}
                      <span class="trust-badge">{{ block.settings.badge_2 }}</span>
                    {% endif %}
                    {% if block.settings.badge_3 != blank %}
                      <span class="trust-badge">{{ block.settings.badge_3 }}</span>
                    {% endif %}
                    {% if block.settings.badge_4 != blank %}
                      <span class="trust-badge">{{ block.settings.badge_4 }}</span>
                    {% endif %}
                    {% if block.settings.badge_5 != blank %}
                      <span class="trust-badge">{{ block.settings.badge_5 }}</span>
                    {% endif %}
                    {% if block.settings.badge_6 != blank %}
                      <span class="trust-badge">{{ block.settings.badge_6 }}</span>
                    {% endif %}
                  </div>
                </div>

              {%- when 'collapsible_tab' -%}
                <div class="alma-product__accordion accordion" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary>
                      <div class="summary__title">
                        <h2 class="h4 accordion__title">
                          {{ block.settings.heading | default: block.settings.page.title | escape }}
                        </h2>
                      </div>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>

              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}

            {%- endcase -%}
          {%- endfor -%}
        </section>
      </div>
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </div>

  <script>
    function almaToggleSubscription(type, sectionId) {
      const originalPriceInput = document.getElementById(`original-price-${sectionId}`);
      const subscriptionPriceInput = document.getElementById(`subscription-price-${sectionId}`);
      
      if (!originalPriceInput || !subscriptionPriceInput) return;
      
      const originalPrice = parseInt(originalPriceInput.value);
      const subscriptionPrice = parseInt(subscriptionPriceInput.value);
      
      // Update active state on options
      const selector = document.querySelector(`#AlmaProduct-${sectionId} .alma-subscription-selector`);
      if (selector) {
        selector.querySelectorAll('.subscription-option').forEach(option => {
          option.classList.remove('active');
        });
        selector.querySelector(`[data-type="${type}"]`)?.classList.add('active');
      }
      
      // Update main price display
      const priceElement = document.querySelector(`#price-${sectionId} .price-item--regular`);
      if (priceElement) {
        const formatMoney = (cents) => {
          return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',');
        };
        
        if (type === 'subscription') {
          priceElement.textContent = formatMoney(subscriptionPrice);
        } else {
          priceElement.textContent = formatMoney(originalPrice);
        }
      }
      
      // Show/hide subscription message
      const message = document.getElementById(`subscription-message-${sectionId}`);
      const quantitySelector = document.querySelector(`#AlmaProduct-${sectionId} .alma-product-form__quantity`);
      
      if (type === 'subscription') {
        if (message) message.classList.add('active');
        if (quantitySelector) {
          quantitySelector.classList.add('hidden-by-subscription');
          const quantityInput = quantitySelector.querySelector('input[name="quantity"]');
          if (quantityInput) quantityInput.value = 1;
        }
      } else {
        if (message) message.classList.remove('active');
        if (quantitySelector) {
          quantitySelector.classList.remove('hidden-by-subscription');
        }
      }
      
      // Store selection
      const subscriptionInput = document.getElementById(`subscription-type-${sectionId}`);
      if (subscriptionInput) {
        subscriptionInput.value = type;
      }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
      const sectionId = '{{ section.id }}';
      almaToggleSubscription('onetime', sectionId);
    });
  </script>
</product-info>

{% schema %}
{
  "name": "Alma Product",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1
    },
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subtitle Text",
          "default": "<p>Product subtitle or tagline</p>"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Product Rating",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "subscription_selector",
      "name": "Subscription Options",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            {
              "value": "dropdown",
              "label": "Dropdown"
            },
            {
              "value": "button",
              "label": "Buttons"
            }
          ],
          "default": "button",
          "label": "Type"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity Selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badge_1",
          "label": "Badge 1",
          "default": "🔒 Pagamento 100% Seguro"
        },
        {
          "type": "text",
          "id": "badge_2",
          "label": "Badge 2",
          "default": "🚚 Frete Grátis Brasil"
        },
        {
          "type": "text",
          "id": "badge_3",
          "label": "Badge 3",
          "default": "✅ 60 Dias de Garantia"
        },
        {
          "type": "text",
          "id": "badge_4",
          "label": "Badge 4",
          "default": "🇧🇷 Produzido no Brasil"
        },
        {
          "type": "text",
          "id": "badge_5",
          "label": "Badge 5",
          "default": "🧪 Fórmula Cientificamente Testada"
        },
        {
          "type": "text",
          "id": "badge_6",
          "label": "Badge 6",
          "default": "🌿 100% Natural"
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Collapsible Tab",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "Enable Sticky Product Info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Alma Product",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "subtitle"
        },
        {
          "type": "rating"
        },
        {
          "type": "price"
        },
        {
          "type": "subscription_selector"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "quantity_selector"
        },
        {
          "type": "buy_buttons"
        },
        {
          "type": "trust_badges"
        },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Descrição"
          }
        },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Como Usar"
          }
        }
      ]
    }
  ]
}
{% endschema %}

