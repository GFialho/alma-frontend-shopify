{% comment %}
  Alma Product Section - Clean layout matching default Shopify style with subscription options
{% endcomment %}

{%- liquid
  assign current_product = product
  if section.settings.product != blank
    assign current_product = all_products[section.settings.product]
  endif
-%}

<product-info
  id="AlmaProduct-{{ section.id }}"
  class="alma-product section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}{% if section.settings.secondary_background %} background-secondary{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ current_product.id }}"
  data-update-url="true"
  data-url="{{ current_product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'section-alma-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {% unless current_product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-{{ section.id }}" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {% assign variant_images = current_product.images | where: 'attached_to_variant?', true | map: 'src' %}
  
  <div class="page-width">
    <div class="alma-product__grid product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} grid grid--1-col {% if current_product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <!-- Product Media -->
      <div class="grid__item product__media-wrapper alma-product__media">
        {%- if current_product != blank -%}
          {% render 'product-media-gallery', product: current_product, variant_images: variant_images %}
        {%- else -%}
          <div class="product__media-item">
            <div class="product-media-container" style="--ratio: 1.0; --preview-ratio: 1.0;">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="grid__item product__info-wrapper alma-product__info{% if section.settings.enable_sticky_info %} alma-product__info--sticky{% endif %}">
        {%- assign product_form_id = 'product-form-alma-' | append: section.id -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            
            {%- when '@app' -%}
              {% render block %}
            
            {%- when 'vendor' -%}
              <div class="alma-product__vendor" {{ block.shopify_attributes }}>
                <p class="caption-with-letter-spacing">{{ current_product.vendor }}</p>
              </div>

            {%- when 'title' -%}
              <div class="alma-product__title" {{ block.shopify_attributes }}>
                <h1>{{ current_product.title | escape }}</h1>
              </div>

            {%- when 'price' -%}
              <div id="price-{{ section.id }}" class="alma-product__price" role="status" {{ block.shopify_attributes }}>
                {%- render 'price', product: current_product, use_variant: true, show_badges: true -%}
              </div>

            {%- when 'variant_picker' -%}
              {% render 'product-variant-picker', product: current_product, block: block, product_form_id: product_form_id %}

            {%- when 'subscription_selector' -%}
              {%- if current_product.selling_plan_groups.size > 0 -%}
                <div class="alma-subscription-wrapper" {{ block.shopify_attributes }}>
                  {%- assign first_selling_plan_group = current_product.selling_plan_groups.first -%}
                  {%- assign first_selling_plan = first_selling_plan_group.selling_plans.first -%}
                  
                  <div class="alma-subscription-options">
                    <label class="alma-subscription-option active" data-type="onetime">
                      <input type="radio" 
                             name="purchase_type_{{ section.id }}" 
                             value="onetime" 
                             checked 
                             onchange="almaToggleSubscription('onetime', null, '{{ section.id }}')">
                      <div class="alma-subscription-content">
                        <span class="alma-subscription-title">Compra Única</span>
                        <span class="alma-subscription-price" id="onetime-price-{{ section.id }}">
                          {{ current_product.selected_or_first_available_variant.price | money }}
                        </span>
                      </div>
                    </label>
                    
                    {%- for selling_plan in first_selling_plan_group.selling_plans limit: 1 -%}
                      <label class="alma-subscription-option" data-type="subscription">
                        <input type="radio" 
                               name="purchase_type_{{ section.id }}" 
                               value="subscription"
                               data-selling-plan-id="{{ selling_plan.id }}"
                               onchange="almaToggleSubscription('subscription', {{ selling_plan.id }}, '{{ section.id }}')">
                        <div class="alma-subscription-content">
                          <span class="alma-subscription-title">{{ selling_plan.name }}</span>
                          <span class="alma-subscription-price" id="subscription-price-{{ section.id }}">
                            {%- assign subscription_price = current_product.selected_or_first_available_variant.price | times: selling_plan.price_adjustments.first.value | divided_by: 100.0 -%}
                            {{ subscription_price | money }}/{{ selling_plan.options.first.value }}
                          </span>
                          {%- if selling_plan.price_adjustments.first.value < 100 -%}
                            {%- assign discount = 100 | minus: selling_plan.price_adjustments.first.value -%}
                            <span class="alma-subscription-badge">Economize {{ discount }}%</span>
                          {%- endif -%}
                        </div>
                      </label>
                    {%- endfor -%}
                  </div>
                  
                  <div class="alma-subscription-message" id="subscription-message-{{ section.id }}" style="display: none;">
                    ✓ Você receberá automaticamente com desconto exclusivo
                  </div>

                  <input type="hidden" id="original-price-{{ section.id }}" value="{{ current_product.selected_or_first_available_variant.price }}">
                  <input type="hidden" id="selling-plan-id-{{ section.id }}" value="">
                </div>
              {%- endif -%}

            {%- when 'quantity_selector' -%}
              <div class="alma-product__quantity" {{ block.shopify_attributes }} id="quantity-wrapper-{{ section.id }}">
                <label for="Quantity-{{ section.id }}">Quantidade</label>
                <quantity-input class="quantity" data-url="{{ current_product.url }}" data-section="{{ section.id }}">
                  <button class="quantity__button" name="minus" type="button">
                    <span class="visually-hidden">Diminuir quantidade</span>
                    {{- 'icon-minus.svg' | inline_asset_content -}}
                  </button>
                  <input
                    class="quantity__input"
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    min="1"
                    value="1"
                    form="{{ product_form_id }}"
                  >
                  <button class="quantity__button" name="plus" type="button">
                    <span class="visually-hidden">Aumentar quantidade</span>
                    {{- 'icon-plus.svg' | inline_asset_content -}}
                  </button>
                </quantity-input>
              </div>

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                {%- if current_product != blank -%}
                  <product-form class="product-form" data-section-id="{{ section.id }}">
                    <div class="product-form__error-message-wrapper" role="alert" hidden>
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      <span class="product-form__error-message"></span>
                    </div>

                    {%- form 'product', current_product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ current_product.selected_or_first_available_variant.id }}"
                        {% if current_product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                        class="product-variant-id"
                      >
                      
                      <input type="hidden" id="selling-plan-input-{{ section.id }}" name="selling_plan" value="">

                      <div class="product-form__buttons">
                        <button
                          type="submit"
                          name="add"
                          class="product-form__submit button button--full-width"
                          {% if current_product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                        >
                          <span>
                            {%- if current_product.selected_or_first_available_variant.available == false -%}
                              {{ 'products.product.sold_out' | t | upcase }}
                            {%- else -%}
                              {{ 'products.product.add_to_cart' | t }}
                            {%- endif -%}
                          </span>
                          {%- render 'loading-spinner' -%}
                        </button>
                      </div>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
              </div>

            {%- when 'share' -%}
              {% liquid
                assign share_url = current_product.selected_variant.url | default: current_product.url | prepend: request.origin
                render 'share-button', block: block, share_link: share_url
              %}

            {%- when 'custom_liquid' -%}
              {{ block.settings.custom_liquid }}

            {%- when 'collapsible_tab' -%}
              <div class="product__accordion accordion" {{ block.shopify_attributes }}>
                <details id="Details-{{ block.id }}-{{ section.id }}">
                  <summary>
                    <div class="summary__title">
                      <span>{{ block.settings.heading | default: block.settings.page.title }}</span>
                    </div>
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </summary>
                  <div class="accordion__content rte">
                    {{ block.settings.content }}
                    {{ block.settings.page.content }}
                  </div>
                </details>
              </div>

          {%- endcase -%}
        {%- endfor -%}

        <a href="{{ current_product.url }}" class="link product__view-details">
          Ver informações completas
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </a>
      </div>
    </div>

    {% render 'product-media-modal', product: current_product, variant_images: variant_images %}

    {%- if current_product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </div>

  <script>
    function almaToggleSubscription(type, sellingPlanId, sectionId) {
      // Update active state
      const wrapper = document.querySelector(`#AlmaProduct-${sectionId} .alma-subscription-wrapper`);
      if (wrapper) {
        wrapper.querySelectorAll('.alma-subscription-option').forEach(option => {
          option.classList.remove('active');
        });
        wrapper.querySelector(`[data-type="${type}"]`).classList.add('active');
      }
      
      // Show/hide subscription message and quantity
      const message = document.getElementById(`subscription-message-${sectionId}`);
      const quantityWrapper = document.getElementById(`quantity-wrapper-${sectionId}`);
      
      if (type === 'subscription') {
        if (message) message.style.display = 'block';
        if (quantityWrapper) {
          quantityWrapper.style.display = 'none';
          const qtyInput = quantityWrapper.querySelector('input');
          if (qtyInput) qtyInput.value = 1;
        }
      } else {
        if (message) message.style.display = 'none';
        if (quantityWrapper) quantityWrapper.style.display = 'block';
      }
      
      // Update selling plan in form
      const sellingPlanInput = document.getElementById(`selling-plan-input-${sectionId}`);
      if (sellingPlanInput) {
        sellingPlanInput.value = sellingPlanId || '';
      }
      
      // Store selling plan ID for later reference
      const sellingPlanIdInput = document.getElementById(`selling-plan-id-${sectionId}`);
      if (sellingPlanIdInput) {
        sellingPlanIdInput.value = sellingPlanId || '';
      }
      
      // Trigger variant change event to update price if needed
      const variantId = document.querySelector('.product-variant-id')?.value;
      if (variantId) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);
        if (sellingPlanId) {
          url.searchParams.set('selling_plan', sellingPlanId);
        } else {
          url.searchParams.delete('selling_plan');
        }
        
        // Update URL without reload
        window.history.replaceState({}, '', url);
      }
    }
    
    // Listen for variant changes to maintain subscription selection
    document.addEventListener('DOMContentLoaded', function() {
      const sectionId = '{{ section.id }}';
      const productInfo = document.getElementById(`AlmaProduct-${sectionId}`);
      
      if (productInfo) {
        productInfo.addEventListener('variant:change', function(event) {
          // Maintain subscription selection when variant changes
          const selectedOption = document.querySelector(`input[name="purchase_type_${sectionId}"]:checked`);
          if (selectedOption && selectedOption.value === 'subscription') {
            const sellingPlanId = selectedOption.dataset.sellingPlanId;
            if (sellingPlanId) {
              const sellingPlanInput = document.getElementById(`selling-plan-input-${sectionId}`);
              if (sellingPlanInput) {
                sellingPlanInput.value = sellingPlanId;
              }
            }
          }
        });
      }
    });
  </script>
</product-info>

{% schema %}
{
  "name": "Alma Product",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "subscription_selector",
      "name": "Subscription Options",
      "limit": 1
    },
    {
      "type": "quantity_selector",
      "name": "Quantity Selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "Share Label",
          "default": "Compartilhar"
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Collapsible Tab",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produto"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "secondary_background",
      "default": false,
      "label": "Fundo secundário"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "Ativar informações fixas do produto"
    },
    {
      "type": "header",
      "content": "Mídia"
    },
    {
      "type": "select",
      "id": "media_size",
      "options": [
        {
          "value": "small",
          "label": "Pequeno"
        },
        {
          "value": "medium",
          "label": "Médio"
        },
        {
          "value": "large",
          "label": "Grande"
        }
      ],
      "default": "medium",
      "label": "Largura"
    },
    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "default": true,
      "label": "Ajustar à altura da tela"
    },
    {
      "type": "select",
      "id": "media_fit",
      "options": [
        {
          "value": "contain",
          "label": "Ajustar ao contêiner"
        },
        {
          "value": "cover",
          "label": "Cobrir contêiner"
        }
      ],
      "default": "contain",
      "label": "Ajuste"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "options": [
        {
          "value": "stacked",
          "label": "Empilhado"
        },
        {
          "value": "columns",
          "label": "Colunas"
        },
        {
          "value": "thumbnail",
          "label": "Miniatura"
        },
        {
          "value": "thumbnail_slider",
          "label": "Controle deslizante de miniatura"
        }
      ],
      "default": "stacked",
      "label": "Layout da galeria"
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "options": [
        {
          "value": "columns",
          "label": "Colunas"
        },
        {
          "value": "show",
          "label": "Mostrar miniaturas"
        },
        {
          "value": "hide",
          "label": "Ocultar miniaturas"
        }
      ],
      "default": "hide",
      "label": "Miniaturas em dispositivos móveis"
    },
    {
      "type": "select",
      "id": "media_position",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "right",
          "label": "Direita"
        }
      ],
      "default": "left",
      "label": "Posição"
    },
    {
      "type": "select",
      "id": "image_zoom",
      "options": [
        {
          "value": "lightbox",
          "label": "Abrir janela modal"
        },
        {
          "value": "hover",
          "label": "Passar cursor para aplicar zoom"
        },
        {
          "value": "none",
          "label": "Sem zoom"
        }
      ],
      "default": "lightbox",
      "label": "Zoom"
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "Ocultar a mídia de outras variantes depois que uma for selecionada"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "default": false,
      "label": "Repetir vídeo"
    },
    {
      "type": "header",
      "content": "Preenchimento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Acima",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abaixo",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Alma Product",
      "blocks": [
        {
          "type": "vendor"
        },
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "subscription_selector"
        },
        {
          "type": "quantity_selector"
        },
        {
          "type": "buy_buttons"
        },
        {
          "type": "share"
        }
      ]
    }
  ]
}
{% endschema %}
