            "custom_liquid": "<div class=\"subscription-selector\" data-original-price=\"{{ product.price }}\" data-subscription-price=\"{{ product.price | times: 0.8 }}\">\n  <style>\n    .subscription-selector {\n      margin: 20px 0;\n    }\n    .subscription-options {\n      display: flex;\n      gap: 12px;\n      margin-bottom: 16px;\n    }\n    .subscription-option {\n      flex: 1;\n      padding: 16px;\n      border: 2px solid #e0e0e0;\n      border-radius: 12px;\n      cursor: pointer;\n      transition: all 0.3s ease;\n      text-align: center;\n      background: white;\n    }\n    .subscription-option:hover {\n      border-color: #c5a99c;\n    }\n    .subscription-option.active {\n      border-color: #c5a99c;\n      background: #faf8f7;\n    }\n    .subscription-option-title {\n      font-weight: 600;\n      font-size: 16px;\n      margin-bottom: 4px;\n    }\n    .subscription-option-price {\n      font-size: 14px;\n      color: #666;\n    }\n    .subscription-option-badge {\n      display: inline-block;\n      background: #7e9278;\n      color: white;\n      padding: 4px 12px;\n      border-radius: 20px;\n      font-size: 12px;\n      margin-top: 8px;\n      font-weight: 600;\n    }\n    .subscription-message {\n      display: none;\n      padding: 12px 16px;\n      background: #f0f8f0;\n      border-left: 4px solid #7e9278;\n      border-radius: 4px;\n      margin-top: 12px;\n    }\n    .subscription-message.active {\n      display: block;\n    }\n    .subscription-message-text {\n      font-size: 14px;\n      color: #2c5f2d;\n      margin: 0;\n    }\n    \n    /* Hide quantity selector when subscription is selected */\n    .product-form__quantity.hidden-by-subscription {\n      display: none !important;\n    }\n    \n    /* Fix quantity selector layout */\n    .product-form__quantity {\n      margin: 0 0 20px 0 !important;\n    }\n    \n    .quantity__label {\n      display: block !important;\n      margin-bottom: 10px !important;\n      font-size: 14px !important;\n      font-weight: 500 !important;\n    }\n    \n    .price-per-item__container {\n      display: inline-flex !important;\n      align-items: center !important;\n      gap: 0 !important;\n      border: 1px solid #d1d1d1 !important;\n      border-radius: 4px !important;\n      overflow: hidden !important;\n      background: white !important;\n      height: 44px !important;\n    }\n    \n    .quantity__button {\n      width: 44px !important;\n      height: 44px !important;\n      display: flex !important;\n      align-items: center !important;\n      justify-content: center !important;\n      border: none !important;\n      background: white !important;\n      cursor: pointer !important;\n      transition: background 0.15s ease !important;\n      padding: 0 !important;\n      margin: 0 !important;\n      flex-shrink: 0 !important;\n      font-size: 18px !important;\n    }\n    \n    .quantity__button:hover {\n      background: #f8f8f8 !important;\n    }\n    \n    .quantity__button svg {\n      width: 14px !important;\n      height: 14px !important;\n    }\n    \n    .quantity__input {\n      width: 60px !important;\n      height: 44px !important;\n      text-align: center !important;\n      border: none !important;\n      border-left: 1px solid #d1d1d1 !important;\n      border-right: 1px solid #d1d1d1 !important;\n      font-size: 16px !important;\n      font-weight: 500 !important;\n      background: white !important;\n      -moz-appearance: textfield !important;\n      appearance: none !important;\n      flex-shrink: 0 !important;\n      margin: 0 !important;\n      padding: 0 !important;\n      line-height: 44px !important;\n    }\n    \n    .quantity__input::-webkit-outer-spin-button,\n    .quantity__input::-webkit-inner-spin-button {\n      -webkit-appearance: none !important;\n      margin: 0 !important;\n    }\n    \n    .quantity__input:focus {\n      outline: none !important;\n      border-left-color: #121212 !important;\n      border-right-color: #121212 !important;\n    }\n  </style>\n  \n  <div class=\"subscription-options\">\n    <div class=\"subscription-option active\" data-type=\"onetime\" onclick=\"toggleSubscription('onetime')\">\n      <div class=\"subscription-option-title\">Compra Única</div>\n      <div class=\"subscription-option-price\">{{ product.price | money }}</div>\n    </div>\n    <div class=\"subscription-option\" data-type=\"subscription\" onclick=\"toggleSubscription('subscription')\">\n      <div class=\"subscription-option-title\">Assinatura</div>\n      <div class=\"subscription-option-price\">{{ product.price | times: 0.8 | money }}/mês</div>\n      <div class=\"subscription-option-badge\">Economize 20%</div>\n    </div>\n  </div>\n  \n  <div class=\"subscription-message\" id=\"subscription-message\">\n    <p class=\"subscription-message-text\">✓ Você receberá 1 frasco todo mês automaticamente com 20% de desconto</p>\n  </div>\n  \n  <script>\n    function formatMoney(cents) {\n      return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',') + ' BRL';\n    }\n    \n    // Update price based on quantity\n    function updatePriceByQuantity() {\n      const selector = document.querySelector('.subscription-selector');\n      const quantityInput = document.querySelector('input[name=\"quantity\"]');\n      const priceElement = document.querySelector('.price__regular .price-item--regular');\n      \n      if (!selector || !quantityInput || !priceElement) return;\n      \n      const quantity = parseInt(quantityInput.value) || 1;\n      const originalPrice = parseInt(selector.dataset.originalPrice);\n      const subscriptionPrice = parseInt(selector.dataset.subscriptionPrice);\n      const subscriptionType = document.getElementById('subscription-type')?.value || 'onetime';\n      \n      const unitPrice = subscriptionType === 'subscription' ? subscriptionPrice : originalPrice;\n      const totalPrice = unitPrice * quantity;\n      \n      priceElement.textContent = formatMoney(totalPrice);\n    }\n    \n    function toggleSubscription(type) {\n      const selector = document.querySelector('.subscription-selector');\n      const originalPrice = parseInt(selector.dataset.originalPrice);\n      const subscriptionPrice = parseInt(selector.dataset.subscriptionPrice);\n      \n      // Update active state on options\n      document.querySelectorAll('.subscription-option').forEach(option => {\n        option.classList.remove('active');\n      });\n      document.querySelector(`[data-type=\"${type}\"]`).classList.add('active');\n      \n      // Update main price display\n      const priceElement = document.querySelector('.price__regular .price-item--regular');\n      if (priceElement) {\n        if (type === 'subscription') {\n          priceElement.textContent = formatMoney(subscriptionPrice);\n        } else {\n          priceElement.textContent = formatMoney(originalPrice);\n        }\n      }\n      \n      // Show/hide subscription message\n      const message = document.getElementById('subscription-message');\n      const quantitySelector = document.querySelector('.product-form__quantity');\n      \n      if (type === 'subscription') {\n        message.classList.add('active');\n        if (quantitySelector) {\n          quantitySelector.classList.add('hidden-by-subscription');\n          // Set quantity to 1 for subscription\n          const quantityInput = quantitySelector.querySelector('input[name=\"quantity\"]');\n          if (quantityInput) quantityInput.value = 1;\n        }\n      } else {\n        message.classList.remove('active');\n        if (quantitySelector) {\n          quantitySelector.classList.remove('hidden-by-subscription');\n        }\n      }\n      \n      // Store selection in the hidden input (now in buy-buttons snippet)\n      const subscriptionInput = document.getElementById('subscription-type');\n      if (subscriptionInput) {\n        subscriptionInput.value = type;\n      } else {\n        console.warn('Subscription type input not found in form');\n      }\n      \n      // Update price based on current quantity\n      updatePriceByQuantity();\n    }\n    \n    // Initialize on page load\n    document.addEventListener('DOMContentLoaded', function() {\n      toggleSubscription('onetime');\n      \n      // Listen for quantity changes\n      const quantityInput = document.querySelector('input[name=\"quantity\"]');\n      if (quantityInput) {\n        quantityInput.addEventListener('change', updatePriceByQuantity);\n        quantityInput.addEventListener('input', updatePriceByQuantity);\n      }\n      \n      // Listen for quantity button clicks\n      const quantityButtons = document.querySelectorAll('.quantity__button');\n      quantityButtons.forEach(button => {\n        button.addEventListener('click', function() {\n          setTimeout(updatePriceByQuantity, 50);\n        });\n      });\n    });\n  </script>\n</div>"
